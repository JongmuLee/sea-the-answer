# Copy to .env. Secrets are server-only and must never be committed.
# Required: PostgreSQL database with backend/pyapi/schema.sql applied.
DATABASE_URL=postgresql://haedap_user:replace-password@127.0.0.1:5432/haedap
# Optional: backup file directory; default backend/data/backups.
# HAEDAP_BACKUP_DIR=backend/data/backups
# Port users open (Next.js). --port / scripts\start.cmd -Port takes precedence.
PORT=5173
# Internal API server (127.0.0.1 only). Next.js forwards /api/* here.
# Read by both processes at startup; restart them after changing it (no rebuild needed).
# HAEDAP_API_ORIGIN=http://127.0.0.1:8000
# Optional: path to the uv executable when it is not on PATH.
# HAEDAP_UV=
# Optional: comma-separated public hostnames or local IP addresses for LAN access.
# HAEDAP_ALLOWED_HOSTS=
# Optional: configure both to enable grounded model responses. Keep the key server-side.
# OPENAI_API_KEY=
# OPENAI_MODEL=
