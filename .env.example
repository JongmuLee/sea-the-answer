# Copy to .env (repository root). docker compose reads it automatically.
# Secrets are server-only and must never be committed.

# --- PostgreSQL (compose service "db"; never published outside the compose network) ---
# Change the password before running on a shared server. Avoid @ : / in it (it goes into a URL).
POSTGRES_DB=haedap
POSTGRES_USER=haedap
POSTGRES_PASSWORD=haedap-local

# --- Public entry point (Next.js) ---
PORT=5173
# 127.0.0.1 = this computer only. 0.0.0.0 = accept LAN/server traffic (also set HAEDAP_ALLOWED_HOSTS).
HAEDAP_BIND=127.0.0.1
# Comma-separated hostnames or IPs users open besides localhost, e.g. 192.168.0.10,haedap.example.com
HAEDAP_ALLOWED_HOSTS=

# --- Optional: grounded model responses (backend only) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Optional: maritime data tool, mounted at /api/maritime-data/* (ADR 0008) ---
# Bearer token, at least 32 characters. Empty = routes disabled.
MARITIME_DATA_API_TOKEN=
# Defaults to the main database when empty.
MARITIME_DATA_DATABASE_URL=

# --- Running without Docker (see README "Docker 없이") ---
# Shared by dbmate and the backend.
# migrations: npx --yes dbmate@2.36.0 -d migrations --no-dump-schema up
# backend:    cd backend && uv run --env-file ../.env uvicorn api.main:app --reload
# DATABASE_URL=postgresql://haedap:haedap-local@127.0.0.1:5432/haedap?sslmode=disable
# frontend: Next.js reads only this value from the root .env.
# HAEDAP_API_ORIGIN=http://127.0.0.1:8000
